package com.neighborhood.servicefinder.controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.core.Authentication;
import org.springframework.web.bind.annotation.*;

import com.neighborhood.servicefinder.exception.ResourceNotFoundException;
import com.neighborhood.servicefinder.model.Booking;
import com.neighborhood.servicefinder.model.User;
import com.neighborhood.servicefinder.repository.BookingRepository;
import com.neighborhood.servicefinder.repository.UserRepository;

@RestController
@RequestMapping("/api/bookings")
public class BookingController {

    @Autowired
    private BookingRepository bookingRepository;

    @Autowired
    private UserRepository userRepository;

    // 1️⃣ Create a new booking (USER only)
    @PreAuthorize("hasRole('USER')")
    @PostMapping
    public ResponseEntity<String> createBooking(@RequestBody Booking booking, Authentication authentication) {
        String userEmail = authentication.getName(); // Extract logged-in user's email
        User user = userRepository.findByEmail(userEmail)
                .orElseThrow(() -> new ResourceNotFoundException("User not found"));

        booking.setUser(user);
        bookingRepository.save(booking);

        return ResponseEntity.ok("Booking created successfully!");
    }

    // 2️⃣ Get all bookings (ADMIN only)
    @PreAuthorize("hasRole('ADMIN')")
    @GetMapping
    public ResponseEntity<List<Booking>> getAllBookings() {
        return ResponseEntity.ok(bookingRepository.findAll());
    }

    // 3️⃣ Get booking by ID
    @PreAuthorize("hasAnyRole('USER','ADMIN')")
    @GetMapping("/{id}")
    public ResponseEntity<Booking> getBookingById(@PathVariable Long id, Authentication authentication) {
        Booking booking = bookingRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Booking not found"));

        String userEmail = authentication.getName();
        User user = userRepository.findByEmail(userEmail)
                .orElseThrow(() -> new ResourceNotFoundException("User not found"));

        // If USER, check ownership
        if (user.getRole().name().equals("USER") && !booking.getUser().getId().equals(user.getId())) {
            return ResponseEntity.status(403).build(); // Forbidden
        }

        return ResponseEntity.ok(booking);
    }

    // 4️⃣ Get bookings of logged-in user
    @PreAuthorize("hasRole('USER')")
    @GetMapping("/my")
    public ResponseEntity<List<Booking>> getMyBookings(Authentication authentication) {
        String userEmail = authentication.getName();
        User user = userRepository.findByEmail(userEmail)
                .orElseThrow(() -> new ResourceNotFoundException("User not found"));

        List<Booking> bookings = bookingRepository.findByUserId(user.getId());
        return ResponseEntity.ok(bookings);
    }

    // 5️⃣ PROVIDER updates booking status
    @PreAuthorize("hasRole('PROVIDER')")
    @PutMapping("/{id}/status")
    public ResponseEntity<String> updateBookingStatus(@PathVariable Long id, @RequestParam String status,
                                                      Authentication authentication) {
        Booking booking = bookingRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Booking not found"));

        String providerEmail = authentication.getName();
        User provider = userRepository.findByEmail(providerEmail)
                .orElseThrow(() -> new ResourceNotFoundException("Provider not found"));

        // Optional: you can check if the provider is allowed to update this booking
        // For now, any PROVIDER can update any booking

        booking.setStatus(status);
        bookingRepository.save(booking);

        return ResponseEntity.ok("Booking status updated to " + status);
    }
}
