package com.neighborhood.servicefinder.controller;

import com.neighborhood.servicefinder.exception.ResourceNotFoundException;
import com.neighborhood.servicefinder.model.Service;
import com.neighborhood.servicefinder.model.User;
import com.neighborhood.servicefinder.repository.ServiceRepository;
import com.neighborhood.servicefinder.repository.UserRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.core.Authentication;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/services")
public class ServiceController {

    @Autowired
    private ServiceRepository serviceRepository;

    @Autowired
    private UserRepository userRepository;

    // Any authenticated user can view all services
    @PreAuthorize("hasAnyRole('USER','PROVIDER','ADMIN')")
    @GetMapping
    public ResponseEntity<List<Service>> getAllServices() {
        return ResponseEntity.ok(serviceRepository.findAll());
    }

    // Any authenticated user can view a single service
    @PreAuthorize("hasAnyRole('USER','PROVIDER','ADMIN')")
    @GetMapping("/{id}")
    public ResponseEntity<Service> getServiceById(@PathVariable Long id) {
        Service service = serviceRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Service not found"));
        return ResponseEntity.ok(service);
    }

    // Only PROVIDER can add a service
    @PreAuthorize("hasRole('PROVIDER')")
    @PostMapping
    public ResponseEntity<Service> addService(@RequestBody Service service, Authentication authentication) {
        String providerEmail = authentication.getName();
        User provider = userRepository.findByEmail(providerEmail)
                .orElseThrow(() -> new ResourceNotFoundException("Provider not found"));

        service.setProvider(provider); // Set the logged-in provider
        return ResponseEntity.ok(serviceRepository.save(service));
    }

    // Only PROVIDER can update their own service
    @PreAuthorize("hasRole('PROVIDER')")
    @PutMapping("/{id}")
    public ResponseEntity<Service> updateService(@PathVariable Long id,
                                                 @RequestBody Service serviceDetails,
                                                 Authentication authentication) {
        String providerEmail = authentication.getName();
        User provider = userRepository.findByEmail(providerEmail)
                .orElseThrow(() -> new ResourceNotFoundException("Provider not found"));

        return serviceRepository.findById(id).map(service -> {
            if (!service.getProvider().getId().equals(provider.getId())) {
                return ResponseEntity.status(403).build(); // Forbidden
            }
            service.setName(serviceDetails.getName());
            service.setCategory(serviceDetails.getCategory());
            service.setDescription(serviceDetails.getDescription());
            service.setPrice(serviceDetails.getPrice());
            serviceRepository.save(service);
            return ResponseEntity.ok(service);
        }).orElse(ResponseEntity.notFound().build());
    }

    // Only PROVIDER can delete their own service
    @PreAuthorize("hasRole('PROVIDER')")
    @DeleteMapping("/{id}")
    public ResponseEntity<String> deleteService(@PathVariable Long id, Authentication authentication) {
        String providerEmail = authentication.getName();
        User provider = userRepository.findByEmail(providerEmail)
                .orElseThrow(() -> new ResourceNotFoundException("Provider not found"));

        return serviceRepository.findById(id).map(service -> {
            if (!service.getProvider().getId().equals(provider.getId())) {
                return ResponseEntity.status(403).build(); // Forbidden
            }
            serviceRepository.delete(service);
            return ResponseEntity.ok("Service deleted successfully");
        }).orElse(ResponseEntity.notFound().build());
    }
}
