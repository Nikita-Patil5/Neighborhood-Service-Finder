<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Booking Confirmation</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f4f4f4; margin:0; padding:0;">
    <table align="center" width="600" cellpadding="0" cellspacing="0" style="background-color: #ffffff; margin-top:20px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1);">
        <tr>
            <td style="background-color: #4CAF50; color: white; text-align: center; padding: 20px; font-size: 24px; font-weight: bold;">
                Booking Confirmed!
            </td>
        </tr>
        <tr>
            <td style="padding: 20px;">
                <p>Hi <b th:text="${userName}">User Name</b>,</p>
                <p>Your booking for <b th:text="${serviceName}">Service Name</b> has been successfully created.</p>

                <table width="100%" cellpadding="5" cellspacing="0" style="margin-top: 10px; border: 1px solid #ddd; border-radius: 4px;">
                    <tr style="background-color: #f9f9f9;">
                        <td><b>Date</b></td>
                        <td th:text="${date}">2025-09-22</td>
                    </tr>
                    <tr>
                        <td><b>Time</b></td>
                        <td><span th:text="${startTime}">10:00</span> to <span th:text="${endTime}">11:00</span></td>
                    </tr>
                    <tr style="background-color: #f9f9f9;">
                        <td><b>Price</b></td>
                        <td>$<span th:text="${price}">100</span></td>
                    </tr>
                </table>

                <p style="margin-top: 20px;">Thank you for choosing our service!</p>
                
                <a th:href="@{/user/bookings}" style="display: inline-block; margin-top: 20px; background-color: #4CAF50; color: white; text-decoration: none; padding: 10px 20px; border-radius: 4px;">View Booking</a>
            </td>
        </tr>
        <tr>
            <td style="background-color: #f1f1f1; text-align: center; color: #555; font-size: 12px; padding: 10px;">
                © 2025 Neighborhood Service Finder
            </td>
        </tr>
    </table>
</body>
</html>
