package com.neighborhood.servicefinder.model;

import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@AllArgsConstructor
@NoArgsConstructor
@Entity
@Table(name = "services")
public class Service {

	@Id
	@GeneratedValue(strategy = GenerationType.IDENTITY)
	private Long id;
	private String name;             //e.g., Plumbing, Electrition
	private String category;		//e.g., Home Repair, Education
	private String description;
	private Double price;			//e.g., Price per hour or per task
	private Long providerId;		//User(Provider) who created it
	
	


	
}
